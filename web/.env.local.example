# Supabase project — create one at https://supabase.com/dashboard, then
# copy this file to .env.local and fill in Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets — read only in API routes/Server Actions. Next.js only
# inlines vars prefixed NEXT_PUBLIC_ into the client bundle, so these two
# never reach the browser. Needed starting Epic E2 (meal plan generation),
# not for E1.
SPOONACULAR_API_KEY=
TAVILY_API_KEY=

# Service-role key (Project Settings > API > service_role) — bypasses RLS.
# Used ONLY by src/lib/supabase/admin.ts for the cross-user
# recipe_query_cache table (Epic E2), which has no per-user owner and is
# default-deny for the anon/authenticated roles. Never use this client for
# profiles/meal_plans/meal_plan_slots.
SUPABASE_SERVICE_ROLE_KEY=

# Auth0 — the sole identity provider (migration 0034_auth0_identity_swap.sql
# replaced Supabase Auth + the old /profiles picker + HTTP Basic Auth with
# this). Every route except the homepage and /api/mcp requires a real Auth0
# session, enforced in proxy.ts. No self-serve signup — accounts are created
# directly in the Auth0 dashboard (Username-Password-Authentication
# connection has "Disable Sign Ups" on).
#
# AUTH0_DOMAIN: bare domain from Applications > <app> > Settings, no
# https:// prefix (the SDK adds it). AUTH0_CLIENT_ID/AUTH0_CLIENT_SECRET:
# same page. AUTH0_SECRET: a random 32+ byte value used to encrypt the
# session cookie (`openssl rand -hex 32`), NOT from the Auth0 dashboard.
# APP_BASE_URL: this app's own base URL (http://localhost:3000 locally).
#
# Account deletion (/account's delete-account action) additionally needs
# this Application authorized as a Machine-to-Machine client for the Auth0
# Management API with the delete:users scope (Auth0 dashboard: APIs > Auth0
# Management API > Machine to Machine Applications) — nothing else here
# requires that authorization.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=

# Bearer token gating the private ops MCP route (src/app/api/mcp/route.ts —
# Supabase admin read-only tools for debugging: inspect a user's generated
# plan, check Spoonacular quota). Unset by default, so the route 401s
# everyone until you deliberately set this yourself. Never share this value
# or wire it into deploy.yml's CI secret sync casually — treat it like
# SUPABASE_SERVICE_ROLE_KEY.
OPS_MCP_TOKEN=
