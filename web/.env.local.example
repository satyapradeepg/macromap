# Supabase project — create one at https://supabase.com/dashboard, then
# copy this file to .env.local and fill in Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets — read only in API routes/Server Actions. Next.js only
# inlines vars prefixed NEXT_PUBLIC_ into the client bundle, so these two
# never reach the browser. Needed starting Epic E2 (meal plan generation),
# not for E1.
SPOONACULAR_API_KEY=
TAVILY_API_KEY=

# Service-role key (Project Settings > API > service_role) — bypasses RLS.
# Used ONLY by src/lib/supabase/admin.ts for the cross-user
# recipe_query_cache table (Epic E2), which has no per-user owner and is
# default-deny for the anon/authenticated roles. Never use this client for
# profiles/meal_plans/meal_plan_slots.
SUPABASE_SERVICE_ROLE_KEY=

# HTTP Basic Auth credentials checked in middleware.ts for every route
# except the homepage and /api/mcp (which has its own OPS_MCP_TOKEN gate).
# Both must be set for anything beyond the homepage to be reachable at all
# -- either unset means every gated request gets a 401. This is a temporary
# showcase credential, not a permanent secret. This used to be a homegrown
# gate cookie scoped only to /profiles, checked per-page; replaced
# 2026-08-01 with a single Basic Auth check in middleware after the cookie
# approach produced two real bugs (a stale comment-only edit, and a cookie
# scoped to the wrong path) from having to keep it in sync with the
# separate Supabase session cookie. Rotate via `gh secret set
# ACCESS_USERNAME/ACCESS_PASSWORD` + a manual `workflow_dispatch` run of
# deploy.yml (no new commit needed) -- the student account driving `az
# containerapp update --set-env-vars` directly doesn't have write access to
# the Container App, only the CI identity does.
ACCESS_USERNAME=
ACCESS_PASSWORD=

# Bearer token gating the private ops MCP route (src/app/api/mcp/route.ts —
# Supabase admin read-only tools for debugging: list test personas, inspect
# a persona's generated plan, check Spoonacular quota). Unset by default, so
# the route 401s everyone until you deliberately set this yourself. Never
# share this value or wire it into deploy.yml's CI secret sync casually —
# treat it like SUPABASE_SERVICE_ROLE_KEY.
OPS_MCP_TOKEN=
